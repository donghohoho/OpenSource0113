# Which API to call: anthropic (default) | baze
AI_PROVIDER=anthropic

# Anthropic API key (used when AI_PROVIDER=anthropic). Never commit the real value.
ANTHROPIC_API_KEY=

# School BAZE gateway (used when AI_PROVIDER=baze)
BAZE_API_KEY=
BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude

# Model / generation
CLAUDE_MODEL=claude-opus-5-5
# Opus 5.5 always thinks; effort controls how much (low|medium|high)
CLAUDE_EFFORT=low
